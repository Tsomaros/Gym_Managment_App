# Copy to .env and change every password. .env is git-ignored.

# --- Docker services (docker compose reads these) ---
POSTGRES_PORT=5433
POSTGRES_PASSWORD=change-me-superuser
GYM_OWNER_PASSWORD=change-me-owner
GYM_APP_PASSWORD=change-me-app
MINIO_ROOT_USER=gym-minio
MINIO_ROOT_PASSWORD=change-me-minio

# --- API ---
# Runtime role: gym_app (no BYPASSRLS). Migrations and systemDb: gym_owner.
DATABASE_URL=postgres://gym_app:change-me-app@localhost:5433/gym
DATABASE_MIGRATOR_URL=postgres://gym_owner:change-me-owner@localhost:5433/gym
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
WEB_ORIGIN=http://localhost:5173
# Mailpit catches all mail locally: http://localhost:8025
SMTP_URL=smtp://localhost:1025
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me-admin
