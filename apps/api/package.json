{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @gym/shared build && nest build",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "start:dev": "pnpm --filter @gym/shared build && nest start --watch --env-file ../../.env",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@gym/shared": "workspace:*",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@swc/core": "^1.16.22",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
